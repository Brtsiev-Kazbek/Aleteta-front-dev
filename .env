# Настройки боевого проекта Supabase «Aleteya».
#
# Здесь лежат только те значения, которые и так уезжают в браузер: адрес
# проекта и публичный ключ попадают в клиентский бандл при любой сборке, и
# доступ к данным ограничивают политики в базе, а не секретность ключа.
#
# Служебного ключа здесь нет и быть не должно: он обходит все политики, а
# репозиторий открытый. Его место — переменные окружения Netlify.
#
# Локальные значения кладите в .env.local — он в git не попадает и
# перекрывает этот файл.

# --- Supabase -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://mqbqpougnlewytqcgtoq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1xYnFwb3Vnbmxld3l0cWNndG9xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5NDYyMjgsImV4cCI6MjEwMTUyMjIyOH0.XVzU7djZZhHAJirITYd73cUmYMH_UWwlotN7HBwQKFM

# --- Адрес приложения -----------------------------------------------
# Куда ведут ссылки из писем. Пусто — адрес собирается из заголовков запроса,
# этого достаточно и на Netlify, и на localhost. Задайте явно, когда появится
# собственный домен.
NEXT_PUBLIC_SITE_URL=

# --- Языковая модель ------------------------------------------------
# Пока не задано: разбор документов и ассистент работают на встроенных данных.
LLM_BASE_URL=https://routerai.ru/v1
LLM_MODE=replay
