# Секреты исполнителя заданий (Edge Function ai-worker).
#
# Это НЕ переменные приложения. Функция живёт в окружении Supabase и переменных
# Netlify не видит — у неё свой набор, который задаётся отдельной командой:
#
#   1. скопируйте этот файл в supabase/functions/.env
#   2. заполните значения
#   3. npm run worker:secrets
#
# Файл .env в этой папке в git не попадает — см. .gitignore.

# Ключ маршрутизатора. ЗДЕСЬ И ТОЛЬКО ЗДЕСЬ: в переменные приложения его класть
# нельзя, приложение не должно уметь позвать модель напрямую даже теоретически.
# Заводите ключ с потолком расхода, а не мастер-ключ.
LLM_API_KEY=

# Именно /api/v1: по адресу без /api отдаётся страница сайта, и запрос
# возвращает кусок HTML вместо ответа.
LLM_BASE_URL=https://routerai.ru/api/v1

# Модель, умеющая читать картинки. На ней держится распознавание.
LLM_MODEL_VISION=qwen/qwen3-vl-32b-instruct

# Дешёвая и сильная модели — для остальных операций. Распознаванию не нужны.
LLM_MODEL_FAST=
LLM_MODEL_SMART=

# ОБЯЗАТЕЛЬНО live. По умолчанию стоит replay: ответы берутся из журнала по
# отпечатку входа, и обращений к модели нет вообще. Это режим разработки —
# сто перезапусков стоят ноль, но и текста при первом запуске не будет.
LLM_MODE=live
