{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPoints": [
    "lib/ai/config.ts",
    "lib/ai/types.ts",
    "lib/ai/prompts.ts",
    "lib/ai/jobs.ts",
    "lib/actions/result.ts",
    "lib/auth/validation.ts",
    "lib/auth/messages.ts",
    "lib/auth/site-url.ts",
    "lib/data/session.ts",
    "lib/data/queries.ts",
    "lib/data/workspace.ts",
    "lib/data/bootstrap.ts",
    "lib/data/mappers.ts",
    "lib/supabase/client.ts",
    "lib/supabase/server.ts",
    "lib/supabase/admin.ts",
    "lib/supabase/config.ts",
    "lib/validation.ts",
    "lib/templates.ts",
    "lib/utils.ts",
    "app/actions/auth.ts",
    "app/actions/cases.ts",
    "app/actions/entities.ts",
    "app/actions/documents.ts",
    "app/actions/workspace.ts",
    "app/actions/ai.ts",
    "store/useAppStore.ts",
    "types/index.ts",
    "types/database.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "categorizeByGroup": true,
  "mergeReadme": false,
  "outputFileStrategy": "modules",
  "entryFileName": "index.md",
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table"
}
