# Образец переменных окружения. Скопируйте в .env.local и заполните.
# Файлы .env*.local в git не попадают — см. .gitignore.

# --- Supabase -------------------------------------------------------
# Адрес проекта и публичный ключ. Оба попадают в браузер — это нормально,
# доступ к данным ограничивают политики в базе, а не секретность ключа.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Служебный ключ. Обходит все политики доступа, поэтому используется только
# на сервере: фоновые задания, миграция данных, выполнение AI-заданий.
# Никогда не префикс NEXT_PUBLIC_ — иначе ключ уедет в браузер.
SUPABASE_SERVICE_ROLE_KEY=

# --- Адрес приложения -----------------------------------------------
# Куда ведут ссылки из писем: подтверждение почты, смена пароля, приглашения.
# Пусто — адрес собирается из заголовков запроса, чего достаточно для разработки
# и превью-сборок. На боевом домене задайте явно: письма уходят и вне запроса.
NEXT_PUBLIC_SITE_URL=

# --- Языковая модель ------------------------------------------------
# Маршрутизатор с OpenAI-совместимым интерфейсом.
LLM_BASE_URL=https://routerai.ru/v1
LLM_API_KEY=

# Модель под каждый класс задач. Дешёвая — на механику, сильная — на
# рассуждение. Разделение экономит больше, чем любые другие приёмы.
LLM_MODEL_FAST=
LLM_MODEL_SMART=
# Модель, умеющая читать картинки: скан выписки — это изображение, текста в
# нём нет. На ней держится извлечение реквизитов.
LLM_MODEL_VISION=
LLM_MODEL_EMBEDDING=

# replay — ответы берутся из журнала ai_jobs по отпечатку входа, обращений
# к модели нет вообще. Режим для разработки: сто перезапусков стоят ноль.
# Значения: replay | live
LLM_MODE=replay

# ВАЖНО: сам ключ LLM_API_KEY приложению не нужен и знать его оно не должно —
# все вызовы модели происходят в Edge Function. Ключ задаётся отдельно:
#   supabase secrets set LLM_API_KEY=... LLM_BASE_URL=... LLM_MODEL_VISION=...
# Здесь он оставлен только для локальных экспериментов вне приложения.
